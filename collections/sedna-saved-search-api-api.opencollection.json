{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sedna Authentication Saved Search API API",
    "version": "2019-01-01"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
