            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create saved search.\n\nRequired API Permissions: SAVEDSEARCH_WRITE"
        },
        {
          "info": {
            "name": "updateSavedSearch",
            "type": "http"
