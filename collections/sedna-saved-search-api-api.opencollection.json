            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update saved search\n\nRequired API Permissions: SAVEDSEARCH_WRITE"
        },
        {
          "info": {
            "name": "deleteSavedSearch",
            "type": "http"
