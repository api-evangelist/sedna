          "http": {
            "method": "DELETE",
            "url": "https://{tenant}.sednanetwork.com/platform/2019-01-01/saved-search/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "userId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Delete a saved search\n\nRequired API Permissions: SAVEDSEARCH_DELETE"
        }
      ]
    }
  ],
  "bundled": true
