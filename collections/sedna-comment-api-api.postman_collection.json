          "request": {
            "name": "get Comments",
            "description": {
              "content": "Get comments across all messages.\n\nRequired API Permissions: COMMENT_READ",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "2019-01-01",
                "comment"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page[limit]",
                  "value": "100"
                },
                {
                  "disabled": false,
                  "key": "page[offset]",
                  "value": "0"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "-createdAt"
                },
                {
                  "disabled": false,
                  "key": "filter[user.id]",
                  "value": "<long>",
                  "description": "Show comments created by this user."
                },
                {
                  "disabled": false,
                  "key": "filter[content]",
                  "value": "<string>",
                  "description": "Show comments that contain these terms."
                },
                {
                  "disabled": false,
                  "key": "filter[since]",
                  "value": "<dateTime>",
                  "description": "Show comments created after this time. Must be ISO 8601 timestamp."
                },
                {
                  "disabled": false,
                  "key": "filter[until]",
                  "value": "<dateTime>",
                  "description": "Show comments created before this time. Must be ISO-8601 timestamp."
                }
              ],
              "variable": [
                {
                  "description": "Your tenant's unique identifier",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
            "header": [
